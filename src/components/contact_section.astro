---
import { siGithub, siX } from "simple-icons";
import type { getSiteData } from "../../data/site_data";

type Props = {
  siteData: ReturnType<typeof getSiteData>;
};

const { siteData } = Astro.props;

const linkedinIconPath =
  "M20.45 20.45h-3.56v-5.58c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.95v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.61 0 4.27 2.38 4.27 5.47v6.27ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45Z";
const mailIconPath =
  "M3.5 6.75A2.75 2.75 0 0 1 6.25 4h11.5a2.75 2.75 0 0 1 2.75 2.75v10.5A2.75 2.75 0 0 1 17.75 20H6.25a2.75 2.75 0 0 1-2.75-2.75V6.75Zm2.75-.95a.95.95 0 0 0-.95.95v.28l6.7 4.24 6.7-4.24v-.28a.95.95 0 0 0-.95-.95H6.25Zm12.45 3.36-6.22 3.94a.9.9 0 0 1-.96 0L5.3 9.16v8.09c0 .52.43.95.95.95h11.5c.52 0 .95-.43.95-.95V9.16Z";

const socialIcons = {
  GitHub: siGithub,
  LinkedIn: { path: linkedinIconPath },
  X: siX,
};
---

<section id="contact" class="landing-section bg-landing-canvas" data-reveal>
  <div class="landing-container space-y-8 text-center sm:space-y-10">
    <div class="space-y-3 sm:space-y-4">
      <p class="landing-eyebrow">{siteData.ui.contactEyebrow}</p>
      <h2 class="landing-heading">{siteData.contactHeading}</h2>
      <p class="mx-auto max-w-xl px-2 text-base leading-[1.47] text-landing-graphite sm:px-0 sm:text-[17px]">
        {siteData.contactDescription}
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a
        href={`mailto:${siteData.email}`}
        aria-label={siteData.ui.email}
        class="flex h-11 min-w-11 shrink-0 items-center justify-center rounded-full border border-landing-hairline bg-landing-canvas px-3 text-sm font-semibold text-landing-graphite transition-colors duration-100 hover:text-landing-ink"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-4.5 w-4.5"
          role="img"
          aria-label={siteData.ui.emailIcon}
        >
          <path fill="currentColor" d={mailIconPath}></path>
        </svg>
      </a>

      {siteData.socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.name}
          class="flex h-11 min-w-11 shrink-0 items-center justify-center rounded-full border border-landing-hairline bg-landing-canvas px-3 text-sm font-semibold text-landing-graphite transition-colors duration-100 hover:text-landing-ink"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-4.5 w-4.5"
            role="img"
            aria-label={`${social.name} icon`}
          >
            <path
              fill="currentColor"
              d={socialIcons[social.name as keyof typeof socialIcons]?.path}
            >
            </path>
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>
