---
import { getLocalePath, type Locale } from "../../data/site_data";
import type { getSiteData } from "../../data/site_data";

type Props = {
  anchorPrefix?: string;
  locale: Locale;
  siteData: ReturnType<typeof getSiteData>;
};

const { anchorPrefix = "", locale, siteData } = Astro.props;
const menuDelay = (index: number) => `${60 + index * 50}ms`;
const hrefFor = (href: string) => `${anchorPrefix}${href}`;
const languageHref = (targetLocale: Locale) => getLocalePath(targetLocale, Astro.url.hash);
const alternateLocale = locale === "en" ? "es" : "en";
const logoSrc = "/jsmarenco-logo.avif";
const translateIconPath =
  "M12.87 15.07a14.58 14.58 0 0 0 2.43-4.17H18V9h-5V7h-2v2H6v1.9h7.18a12.2 12.2 0 0 1-1.72 2.8 13.5 13.5 0 0 1-1.33-2.02H8.05a15.72 15.72 0 0 0 2.1 3.03l-2.44 2.4L9.1 18.5l2.36-2.36 1.47 1.47 1.38-1.38-1.44-1.16ZM19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Zm0 16H5V5h14v14Z";
---

<header
  data-global-nav
  class="sticky top-0 z-(--z-landing-nav) flex h-11 w-full items-center justify-between border-b border-[rgba(0,0,0,0.08)] bg-[rgba(250,250,252,0.92)] px-4 text-landing-ink backdrop-blur-[20px] backdrop-saturate-[180%] transition-[background-color,border-color,color] duration-200 sm:px-5 md:px-8"
>
  <a href={hrefFor("#overview")} class="flex shrink-0 items-center gap-2">
    <span class="relative flex h-7 shrink-0 items-center justify-center">
      <img src={logoSrc} alt="" class="aspect-square h-full w-auto object-contain" width="28" height="28" />
    </span>
    <span class="text-sm font-semibold tracking-tight sm:text-base">{siteData.username}</span>
  </a>

  <nav
    class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-4 min-[834px]:flex lg:gap-5"
    aria-label={siteData.ui.mainNav}
  >
    {siteData.navLinks.map((link) => (
      <a href={hrefFor(link.href)} class="text-xs transition-opacity duration-100 hover:opacity-70 sm:text-sm">
        {link.name}
      </a>
    ))}
  </nav>

  <div class="flex shrink-0 items-center gap-2 sm:gap-3">
    <nav
      class="hidden items-center min-[834px]:flex"
      aria-label={siteData.ui.language}
    >
      <a
        href={languageHref(alternateLocale)}
        data-locale-switch
        class="inline-flex items-center gap-1.5 rounded-landing-pill border border-landing-hairline bg-landing-canvas/80 px-2.5 py-1 text-xs font-semibold text-landing-graphite transition-colors duration-100 hover:text-landing-ink"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-3.5 w-3.5"
          role="img"
          aria-label={siteData.ui.language}
        >
          <path fill="currentColor" d={translateIconPath}></path>
        </svg>
        {alternateLocale.toUpperCase()}
      </a>
    </nav>
    <button
      data-menu-open
      type="button"
      class="flex h-11 w-11 shrink-0 items-center justify-center min-[834px]:hidden"
      aria-label={siteData.ui.openMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="relative block h-3.5 w-5" aria-hidden="true">
        <span class="absolute left-0 top-0 h-px w-full bg-current"></span>
        <span class="absolute left-0 top-1/2 h-px w-full bg-current"></span>
        <span class="absolute bottom-0 left-0 h-px w-full bg-current"></span>
      </span>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  data-mobile-menu
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label={siteData.ui.mobileNav}
  class="mobile-menu fixed inset-0 z-(--z-landing-mobile-nav) flex min-h-dvh flex-col bg-landing-canvas min-[834px]:hidden"
>
  <header class="flex h-11 shrink-0 items-center justify-between border-b border-landing-hairline px-4 sm:px-5">
    <a href={hrefFor("#overview")} data-menu-close class="flex shrink-0 items-center gap-2">
      <img src={logoSrc} alt="" class="aspect-square h-7 w-auto object-contain" width="28" height="28" />
      <span class="text-sm font-semibold tracking-tight text-landing-ink">{siteData.username}</span>
    </a>
    <button
      type="button"
      data-menu-close
      class="flex h-11 w-11 shrink-0 items-center justify-center text-landing-ink"
      aria-label={siteData.ui.closeMenu}
    >
      <span class="relative block h-5 w-5" aria-hidden="true">
        <span class="absolute left-0 top-1/2 h-px w-full rotate-45 bg-current"></span>
        <span class="absolute left-0 top-1/2 h-px w-full -rotate-45 bg-current"></span>
      </span>
    </button>
  </header>

  <nav class="flex flex-1 flex-col justify-center px-6 py-8 sm:px-8" aria-label={siteData.ui.mobileNav}>
    <ul class="flex flex-col">
      {siteData.navLinks.map((link, index) => (
        <li data-menu-item style={`transition-delay: ${menuDelay(index)}`}>
          <a
            href={hrefFor(link.href)}
            data-menu-close
            class="flex min-h-[52px] items-center py-2 text-[2rem] font-semibold leading-none tracking-[-0.02em] text-landing-ink transition-opacity duration-100 hover:opacity-60 active:opacity-40"
          >
            {link.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="shrink-0 border-t border-landing-hairline px-6 py-5 sm:px-8">
    <p class="text-sm text-landing-graphite">{siteData.ui.language}</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <a
        href={languageHref(alternateLocale)}
        data-menu-close
        data-locale-switch
        class="inline-flex items-center gap-2 rounded-landing-pill border border-landing-hairline px-3 py-1.5 text-sm font-semibold text-landing-graphite transition-colors duration-100 hover:text-landing-ink"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          role="img"
          aria-label={siteData.ui.language}
        >
          <path fill="currentColor" d={translateIconPath}></path>
        </svg>
        {alternateLocale.toUpperCase()}
      </a>
    </div>
  </div>
</div>
