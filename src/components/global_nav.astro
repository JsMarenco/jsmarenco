---
import siteData from "../../data/site_data";

type Props = {
  anchorPrefix?: string;
};

const { anchorPrefix = "" } = Astro.props;
const mainNavLinks = siteData.navLinks.filter((link) => link.name !== "Contact");
const menuDelay = (index: number) => `${60 + index * 50}ms`;
const hrefFor = (href: string) => `${anchorPrefix}${href}`;
---

<header
  data-global-nav
  class="sticky top-0 z-(--z-landing-nav) flex h-11 w-full items-center justify-between border-b border-[rgba(0,0,0,0.08)] bg-[rgba(250,250,252,0.92)] px-4 text-landing-ink backdrop-blur-[20px] backdrop-saturate-[180%] transition-[background-color,border-color,color] duration-200 sm:px-5 md:px-8"
>
  <a href={hrefFor("#overview")} class="flex shrink-0 items-center gap-2">
    <span class="relative flex h-6 w-6 shrink-0 items-center justify-center sm:h-7 sm:w-7">
      <img src="/logo.png" alt="" class="h-full w-full object-contain" width="28" height="28" />
    </span>
    <span class="text-sm font-semibold tracking-tight sm:text-base">{siteData.username}</span>
  </a>

  <nav
    class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-4 min-[834px]:flex lg:gap-5"
    aria-label="Main"
  >
    {mainNavLinks.map((link) => (
      <a href={hrefFor(link.href)} class="text-xs transition-opacity duration-100 hover:opacity-70 sm:text-sm">
        {link.name}
      </a>
    ))}
  </nav>

  <div class="flex shrink-0 items-center gap-2 sm:gap-3">
    <a
      href={hrefFor("#contact")}
      class="hidden text-xs transition-opacity duration-100 hover:opacity-70 min-[834px]:inline sm:text-sm"
    >
      Contact
    </a>
    <button
      data-menu-open
      type="button"
      class="flex h-11 w-11 shrink-0 items-center justify-center min-[834px]:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="relative block h-3.5 w-5" aria-hidden="true">
        <span class="absolute left-0 top-0 h-px w-full bg-current"></span>
        <span class="absolute left-0 top-1/2 h-px w-full bg-current"></span>
        <span class="absolute bottom-0 left-0 h-px w-full bg-current"></span>
      </span>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  data-mobile-menu
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  class="mobile-menu fixed inset-0 z-(--z-landing-mobile-nav) flex min-h-dvh flex-col bg-landing-canvas min-[834px]:hidden"
>
  <header class="flex h-11 shrink-0 items-center justify-between border-b border-landing-hairline px-4 sm:px-5">
    <a href={hrefFor("#overview")} data-menu-close class="flex shrink-0 items-center gap-2">
      <img src="/logo.png" alt="" class="h-6 w-6 object-contain" width="24" height="24" />
      <span class="text-sm font-semibold tracking-tight text-landing-ink">{siteData.username}</span>
    </a>
    <button
      type="button"
      data-menu-close
      class="flex h-11 w-11 shrink-0 items-center justify-center text-landing-ink"
      aria-label="Close menu"
    >
      <span class="relative block h-5 w-5" aria-hidden="true">
        <span class="absolute left-0 top-1/2 h-px w-full rotate-45 bg-current"></span>
        <span class="absolute left-0 top-1/2 h-px w-full -rotate-45 bg-current"></span>
      </span>
    </button>
  </header>

  <nav class="flex flex-1 flex-col justify-center px-6 py-8 sm:px-8" aria-label="Mobile">
    <ul class="flex flex-col">
      {siteData.navLinks.map((link, index) => (
        <li data-menu-item style={`transition-delay: ${menuDelay(index)}`}>
          <a
            href={hrefFor(link.href)}
            data-menu-close
            class="flex min-h-[52px] items-center py-2 text-[2rem] font-semibold leading-none tracking-[-0.02em] text-landing-ink transition-opacity duration-100 hover:opacity-60 active:opacity-40"
          >
            {link.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="shrink-0 border-t border-landing-hairline px-6 py-5 sm:px-8">
    <p class="text-sm text-landing-graphite">{siteData.title}</p>
    <a
      href={`mailto:${siteData.email}`}
      data-menu-close
      class="mt-1 inline-block text-sm text-landing-azure transition-opacity duration-100 hover:opacity-70"
    >
      {siteData.email}
    </a>
  </div>
</div>
